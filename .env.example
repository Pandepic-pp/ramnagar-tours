# Leave blank in development: Vite proxies /api to the backend, so the session cookie stays same-origin.
# In production, either serve the site and API from one domain (proxy /api), or set the full API origin here,
# e.g. https://api.example.com  (the API and site must then share a registrable domain: the cookie is SameSite=Lax)
VITE_API_URL=

# Where the dev proxy forwards /api. Matches the backend PORT.
VITE_DEV_API_TARGET=http://localhost:5100
